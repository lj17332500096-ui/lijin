# ===== 模型服务配置 =====

# 必填：API Key
OPENAI_API_KEY=sk-...

# 可选：使用 OpenAI 兼容的第三方网关时填网关地址（例如 https://xxx/v1）；
# 直连 OpenAI 时留空或删除这行
# OPENAI_BASE_URL=https://apihub.agnes-ai.cn/v1

# 可选：指定模型名；不填则使用 SDK 默认模型
# AGENT_MODEL=agnes-2.5-flash

# 自定义网关一般只支持 chat/completions，请设为 false；
# 直连 OpenAI 时保持 true（Responses API）
OPENAI_USE_RESPONSES=false

# 本地/第三方网关使用时关闭追踪上报，避免告警
OPENAI_AGENTS_DISABLE_TRACING=true

# ===== 可选工具配置 =====

# 可选：Tavily API Key（https://app.tavily.com 免费申请），
# 配了之后联网搜索更稳定；不配则自动尝试 DuckDuckGo（免费、无需 Key，效果看网络）
# TAVILY_API_KEY=tvly-...

# 可选：允许 Agent 读取/列出文件的工作区根目录，默认是项目上一级目录
# 如需更改默认目录，取消下一行注释并填写本机的绝对路径。
# WORKSPACE_ROOT=

# ===== 可选：本地向量模型（RAG 语义检索） =====

# 向量模型目录：不填则自动找 项目\models\bge-small-zh-v1.5（推荐把模型放这里）；
# 找不到模型时 RAG 自动降级为纯关键词检索，不影响使用。填 off 可显式关闭。
# 模型格式与下载方式见 README「本地文档问答（RAG）」章节。
# RAG_EMBED_MODEL=

# 可选：看图问答（ask_image）用的多模态模型；不填则用 AGENT_MODEL
# VISION_MODEL=

# ===== 可选：长会话自动摘要阈值（默认已按 256K 上下文的激进档） =====

# 默认：60 轮用户输入 或 累计约 18 万字符（含工具输出）才触发自动摘要；
# 摘要后保留最近 20 轮原文。按需覆盖（例如想早点摘要就调小）：
# AUTO_SUMMARY_MIN_TURNS=6
# AUTO_SUMMARY_TRIGGER_TURNS=60
# AUTO_SUMMARY_TRIGGER_CHARS=180000
# AUTO_SUMMARY_KEEP_TURNS=20
# AUTO_SUMMARY_TRANSCRIPT_CAP=150000
#
# 说明：Web / Project / 终端 / 语音共用同一套阈值（Run 前 Session Preparation 统一触发，
# 由 runtime/context.py 接线；旧超长历史会分块摘要，不会一次性塞给摘要模型）。

# ===== 可选：Context 硬护栏（历史窗口兜底，不依赖摘要模型） =====

# compact 失败 / 历史仍超限时的最后一道 Runtime 保护：
# 超过下限字符（≈粗略 token）或条数时，按最近 AUTO_SUMMARY_KEEP_TURNS 个完整轮次
# 切窗口（保证 tool_call↔tool_result 成对），丢弃更早原文。
# 默认值已保守；可按网关实际窗口调档。
# FORGE_HISTORY_HARD_CHARS=260000
# FORGE_HISTORY_HARD_MESSAGES=500
# FORGE_CONTEXT_GUARD=on        # off 可临时关闭整个护栏（排查用）

# ===== 可选：技能（skills/ 目录） =====

# 每个技能 = 目录里的 skill.md（指令片段）+ 可选 tools.py（自动注册的 @function_tool）
# 逗号分隔启用多个；不填 = 不启用。查看状态：python -c "import skills_loader; print(skills_loader.status_text())"
# SKILLS=weekly_report,dep_doctor

# ===== 可选：项目文件编辑 =====

# 开启后 Agent 可写/改项目目录（my_creative_agent）内文件（白名单后缀 + 自动备份；
# .env/密钥文件/logs/models 等受保护）。请确认你信任后开启。
# ALLOW_PROJECT_EDIT=true

# ===== 可选：动态工具选择 =====

# Laya GGUF 后端需要配套的 encoder GGUF、head GGUF、tokenizer.json，且需先启动 llama.cpp。
# gguf 模式加载失败时保持 Laya 不可用并回落主 Agent，不会悄悄切回其他 Torch checkpoint。
# FORGE_LAYA=on
# FORGE_LAYA_BACKEND=gguf
# FORGE_LAYA_ENCODER_GGUF=
# FORGE_LAYA_HEAD_GGUF=
# FORGE_LAYA_TOKENIZER_DIR=
# FORGE_LAYA_LLM_URL=http://127.0.0.1:8099
# FORGE_LAYA_LLM_TIMEOUT=120
# TUI 启动时自动启动 llama.cpp（仅当服务未运行），后台预热 tokenizer/head，预热完成前禁用输入。
# 服务若由本 TUI 启动，会在 TUI 退出时关闭；预先运行的服务不会被关闭。
# FORGE_LAYA_TUI_AUTOSTART=on
# FORGE_LAYA_LLAMA_SERVER_EXE=
# FORGE_LAYA_LLAMA_BACKEND=sycl
# FORGE_LAYA_LLAMA_GPU_LAYERS=99
# FORGE_LAYA_START_TIMEOUT=180
# 自动启动默认只允许 loopback。仅在确需网络访问时显式设为 on；llama.cpp 无认证，
# 远程绑定会向该地址可达的网络开放推理接口。优先使用防火墙限制来源。
# FORGE_LAYA_TUI_ALLOW_REMOTE_BIND=on

# 默认开启：每轮按查询只给模型配相关工具（32→通常 8~16 个），
# 工具名点名必选 + 关键词分组 + 常驻基础集；不需要时设 off 恢复全量。
# TOOL_ROUTER=on

# 逃生门（生产快恢复）：设 on 后 select_tool_names 直接全量返回，跳过意图识别/裁剪。
# 用于：(1) Router 正则改坏后紧急恢复；(2) 复杂跨族任务（调研+写代码+做PPT）。
# 代价：模型拿全量工具，token 成本略增、决策漂移风险上升（有 C2 熔断兜底）。
# TOOL_ROUTER_FAST=off

# Laya 候选工具排序（可选；只接受已由 Tool Router 筛出的候选，且多阶段任务不收窄）。
# 必须指向单独训练好的多类工具路由 checkpoint；二分类意图模型不适用。
# FORGE_LAYA_TOOL_ROUTE_CHECKPOINT=var/models/laya-tool-route
# FORGE_LAYA_ROUTE_CONF=0.90

# USD / 百万 token。部署者可覆盖默认 Agnes 官方列表价快照；模型/提供方未识别时仍显示未知。
# FORGE_MODEL_PRICING={"model-id":{"input_per_million_usd":0.05,"output_per_million_usd":0.15,"version":"provider-date"}}

# ===== 可选：模型路由与任务预算 =====

# 档位模型（都不填 = 维持单模型现状，零行为变化）：
# MODEL_CHEAP=agnes-2.0-flash        # 轻量档：定时任务/后台渠道自动走（快、省）
# MODEL_REASONING=agnes-2.5-flash    # 重推理档：metadata deep=True 的任务
# MODEL_MAX_OUTPUT_TOKENS=4096       # 可选：覆盖克隆实例的输出上限

# 任务级墙钟预算（秒，run_turn(budget=RunBudget(max_wall_seconds=N)) 或后续调度接线使用）
# TASK_MAX_WALL_SECONDS=600

# ===== 可选：高风险操作审批 =====

# 默认对 run_python / forget_memory / schedule_remove 做审批门：
# chat/voice/web 请求挂起为 WAITING_APPROVAL，由用户批准后自动续跑；
# scheduled(定时任务) 渠道自动拒绝。可关（off）或自定义名单（逗号分隔工具名）。
# APPROVAL=on
# APPROVAL_GATED_TOOLS=run_python,forget_memory,schedule_remove

# ===== 可选：记忆 =====
# 总开关关闭长期、项目与 Episode 记忆的读写、删除、召回及上下文注入。
# FORGE_MEMORY_ENABLED=0
# Episode 自动采集默认开启；关闭后可用 /episode ingest 手动补采。
# EPISODE_INGEST=0
# Episode 统计召回默认开启；独立于自动采集开关。
# EPISODE_RECALL=0
# 每次终态后最多补采多少条历史 Run（1-5000，默认 1000）。
# EPISODE_INGEST_BATCH_SIZE=1000

# ===== 可选：代码执行沙箱 =====

# 开启后 Agent 可在 工作区/code_sandbox/ 里写 Python 并本机运行（受限执行：
# 路径围栏 + 超时强杀 + 剔除密钥环境变量）。默认关闭，请确认你信任后再开。
# ALLOW_CODE_EXEC=true

# ===== 可选：GitHub 抓取工具 =====

# 抓私有仓库 / 提高 API 限额时需要 GitHub Personal Access Token（repo 权限）；抓公开仓库可留空
# GITHUB_TOKEN=ghp_...

# ===== 可选：MCP 外部服务器接入（不填 = 不启用） =====

# JSON 数组，每项 {name, command, args, env, tool_policy, default_tool_policy, idempotent_tools}。
# idempotent_tools 是远端工具原始名数组；只有明确列出的工具会在网络错误后重试。
# allow/approval 只表达授权，不代表调用幂等；未列出的 MCP 工具只尝试一次。
# 工具策略：allow=可直接调用（仍审计）；approval=先走审批门（建议写操作）；
#          deny=不挂载（默认）。不写 tool_policy 时该服务器不会挂出任何工具（fail-closed）。
# 例：GitHub 官方 MCP（需要 GitHub PAT；只读直接放行、写操作需审批）：
# MCP_SERVERS=[{"name":"github","command":"npx","args":["-y","@github/mcp-server"],"env":{"GITHUB_PERSONAL_ACCESS_TOKEN":"ghp_..."},"default_tool_policy":"deny","tool_policy":{"get_issue":"allow","create_issue":"approval","update_issue":"approval"}}]
# 例：文件系统 MCP（可读写！根目录换成最小信任路径，写工具显式 approval）：
# MCP_SERVERS=[{"name":"fs","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","C:\\path\\to\\mcp_fs"],"default_tool_policy":"deny","tool_policy":{"read_file":"allow","read_directory":"allow","write_file":"approval","edit_file":"approval","delete_file":"approval"}}]
# 第一梯队实测示例：
# 浏览器 Playwright（先一次性 npx playwright install chromium）：
# MCP_SERVERS=[{"name":"playwright","command":"npx","args":["-y","@playwright/mcp@latest","--browser","chromium","--headless"],"env":{},"default_tool_policy":"deny","tool_policy":{"browser_navigate":"allow","browser_snapshot":"allow","browser_click":"approval","browser_type":"approval"}}]
# Obsidian 笔记（obsidian-mcp@2 纯文件系统访问 vault，Obsidian 无需打开；工具名自带 obsidian_ 前缀）：
# MCP_SERVERS=[{"name":"obsidian","command":"npx","args":["-y","obsidian-mcp@2","serve","--vault","notes=C:\\path\\to\\obsidian-vault"],"env":{},"default_tool_policy":"deny","tool_policy":{"obsidian_read_note":"allow","obsidian_search_vault":"allow","obsidian_create_note":"approval","obsidian_edit_note":"approval","obsidian_delete_note":"approval"}}]
# SQLite（官方 python server 需隔离 venv 固定 mcp<2，本机示例路径）：
# MCP_SERVERS=[{"name":"sqlite","command":"C:\\path\\to\\mcp-server-sqlite.exe","args":["--db-path","C:\\path\\to\\personal.sqlite"],"env":{},"default_tool_policy":"deny","tool_policy":{"read_query":"allow","list_tables":"allow","describe_table":"allow","write_query":"approval","create_table":"approval","append_insight":"approval"}}]
# 第二梯队示例：
# Chrome DevTools（本机无 Google Chrome 时用 --executablePath 指向 Playwright Chromium）：
# MCP_SERVERS=[{"name":"chrome","command":"npx","args":["-y","chrome-devtools-mcp@latest","--headless","--no-usage-statistics","--executablePath","C:\\path\\to\\chrome.exe"],"env":{},"default_tool_policy":"deny","tool_policy":{"navigate_page":"allow","take_snapshot":"allow","evaluate_script":"approval","click":"approval"}}]
# Fetch 只读抓页（隔离 venv）：
# MCP_SERVERS=[{"name":"fetch","command":"C:\\path\\to\\mcp-server-fetch.exe","args":[],"env":{},"default_tool_policy":"deny","tool_policy":{"fetch":"allow"}}]
# YouTube Transcript（只读；抓取依赖 YouTube 可达性）：
# MCP_SERVERS=[{"name":"youtube","command":"npx","args":["-y","@fabriqa.ai/youtube-transcript-mcp@latest"],"env":{},"default_tool_policy":"deny","tool_policy":{"get-transcript":"allow","get-transcript-languages":"allow"}}]
# 可选：服务器 allowlist（逗号分隔；设置后只连接名单内服务器，名单外不启动）
# FORGE_MCP_ALLOWLIST=github
# 注意：MCP 工具会执行服务器提供的真实操作，只接入你信任的服务器；策略是信任声明，不是 OS 沙箱。
# MCP_SERVERS=

# ===== 可选：本地模型（llama.cpp / Ollama 等 OpenAI 兼容本地 /v1 服务）=====
# 配置后在「项目设置 → 模型」中选择「本地模型」；FORGE_MODEL_PREF 控制全局默认。
# FORGE_LOCAL_MODEL_NAME=my-model.gguf
# FORGE_LOCAL_MODEL_BASE_URL=http://localhost:8080/v1
# FORGE_LOCAL_MODEL_API_KEY=
# FORGE_MODEL_PREF=gateway   # gateway=远程网关(默认) / local=本地

# ===== 可选：完成义务门（Completion Obligation Gate） =====

# 默认开启（P2-5）：回复声明"已修改/已保存/测试通过"等执行型完成时，
# Runtime 必须找到真实执行证据，否则拒绝按完成收尾（含 degraded 路径）。
# 排查/演示时可临时关闭：
# FORGE_OBLIGATION_GATE=off

# ===== 护栏开关与工具执行预算 =====
# 这些开关长期只存在于代码默认值里，且口径不一（部分默认 on、部分默认 off），
# 导致"系统里到底有几道防线在跑"无法从配置回答（审计时踩过这个坑）。
# 显式声明后，tests/test_tool_roster_consistency.py::GuardLeverConsistencyTests
# 会断言 `.env` 的值与代码默认值一致 —— 改一边必须同时改另一边，或删掉该行走默认值。
# ⚠️ `.env` 不入库（含密钥），所以本文件是这些开关对外可见的唯一载体，请保持同步。

# ① 同目标重复调用护栏（Phase 11，runtime/runner.py:761）
#    判据：同一逻辑目标累计第 4 次调用 → 拦截并重定向。默认 on。
FORGE_REPEAT_GUARD=on

# ② 冗余证据守卫 Guard A（runtime/runner.py:676）
#    判据：同工具 + 同参数 + 同 evidence epoch 重复 → 同参数第 2 次即拦。
#    ⚠️ 默认 off：启用会明显改变执行行为，需先跑一轮 50 case 对照再定。
FORGE_REDUNDANT_GUARD=off

# ③ 完成即收口守卫 Guard B（runtime/runner.py:697）
#    判据：义务已满足后仍继续探索 → 首次提示，再犯强制收口。⚠️ 默认 off，理由同上。
FORGE_COMPLETION_READY=off

# ---- 执行预算（单位：次 / 单 Run）----
# 单 Run 工具调用总上限（最后一道闸，落得最晚）
TOOL_BUDGET_TOTAL=20
# web_search 独立上限
TOOL_BUDGET_WEB_SEARCH=5

# ---- 重试与超时归属（审计 P0-8 / P1-15）----
# 一句话规则：重试权只属于 provider 网关（runtime/provider_gateway.py），其他层一律不得再重试。
# 下面各项都已有默认值，**留注释即为默认**；只有做对照实验时才解开注释。
#
# SDK 内建重试次数。默认 0（关闭）。设成非 0 会让「真实 HTTP 次数」变成审计记录里
# sdk_http_attempts 的 (1+n) 倍，并使这部分重试完全不可见。
# FORGE_SDK_MAX_RETRIES=0
#
# 单个 provider（primary / fallback 各自）最多发起的尝试次数（含首次）。默认 3。
# FORGE_PROVIDER_MAX_ATTEMPTS=3
#
# primary + fallback 合并的总尝试预算。默认 6。这是「一轮模型调用最坏打几次 HTTP」的唯一依据。
# FORGE_PROVIDER_MAX_TOTAL_ATTEMPTS=6
#
# 输出格式闸重跑次数（main.execute_turn）。默认 1。每次重跑都会完整重走 agent loop，
# 因此会再消耗一份上面的 provider 预算：最坏 HTTP = (1 + 本值) × 总尝试预算。
# FORGE_FORMAT_RETRY_MAX=1
#
# provider 侧总墙钟上限（秒）。默认 600。注意它只在两次尝试之间检查，兜不住单次挂死，
# 所以必须配合下面的 read 超时一起看。
# FORGE_PROVIDER_TOTAL_TIMEOUT_SECONDS=600
# 单次 HTTP 握手超时（秒）。默认 5。
# FORGE_PROVIDER_CONNECT_TIMEOUT_SECONDS=5
# 单次 HTTP 读取超时（秒）。默认 = 总墙钟 / 3（600s → 200s），
# 保证「一次请求挂死」最多吃掉 1/3 预算，剩下留给重试与 fallback。
# FORGE_PROVIDER_READ_TIMEOUT_SECONDS=200
# 单次 HTTP 写入 / 连接池等待超时（秒）。默认分别跟随 read / connect。
# FORGE_PROVIDER_WRITE_TIMEOUT_SECONDS=200
# FORGE_PROVIDER_POOL_TIMEOUT_SECONDS=5
#
# 流式：首 token 超时与空闲超时（秒）。默认 90 / 120，0 = 关闭该层。
# FORGE_STREAM_FIRST_TOKEN_TIMEOUT_SECONDS=90
# FORGE_STREAM_IDLE_TIMEOUT_SECONDS=120

# ---- 运行时生成物根目录 ----
# 数据库、日志、trace、缓存、测试报告和运行时临时文件统一放入该目录。
# 默认是项目根目录下的 var/；相对路径按项目根目录解析。
# FORGE_RUNTIME_DIR=var
# Optional token price table (USD per 1M tokens). Configure from the selected
# provider's current published rates; unknown models are stored as unpriced.
# Example: FORGE_MODEL_PRICING={"model-id":{"input_per_million_usd":2.5,"output_per_million_usd":10,"version":"2026-09-27"}}
# Router and trace JSONL rotation defaults to 10 MB × 4 files each.
# FORGE_ROUTER_LOG_MAX_BYTES=10000000
# FORGE_TRACE_LOG_MAX_BYTES=10000000
# 可分别覆盖数据库位置；不设置时使用 var/state/ 下的新路径，并兼容现有根目录数据库。
# FORGE_AGENT_DB=var/state/agent.db
# FORGE_SESSIONS_DB=var/state/sessions.sqlite
