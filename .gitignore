# 敏感
.env
*.key
*.pem
*.p12

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# 运行时产物
logs/
traces/
data/
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm
*.tmp
*.temp

# 禁止常见生成物落在仓库根目录（短期临时内容用系统临时目录或 var/tmp/）
/*.log
/*.xml
/tmp/
/.tmp/
/_tmp/
# run_python 内联代码落盘的执行脚本（code_exec.run_python_impl 生成，运行后自动清理；
# 这里兜底防止进程被杀/机器断电时残留被 git add -A 收走）。
# ⚠️ 只锚定本仓自己的命名前缀，**不要**加匹配任意 8 字符名的通配 —— 会误伤用户正常文件。
/_inline_*.py

# 统一运行时、测试与临时产物（仅 var/README.md 纳入版本管理）
var/
!var/
var/*
!var/README.md
tests/reports/

# Agent 内部状态
memory.json
state.json
sandbox/

# 工作草稿（保留 drafts 子目录，忽略其内容）
drafts/*
!drafts/README.md

# IDE / OS
.idea/
.vscode/
*.swp
Thumbs.db
.DS_Store

# WorkBuddy 会话数据（保留 memory 目录的 .md，忽略其余）
.workbuddy/*
!.workbuddy/memory/
.workbuddy/memory/*
!.workbuddy/memory/MEMORY.md
!.workbuddy/memory/20*.md

# 浏览器自动化日志
.playwright-mcp/

# 专家团知识底座（wiki-creator）：可由 raw/ 重新编译的产物，不入库
.wiki-creator/

# 大型二进制/备份
*.zip
*.tar.gz
*.bak
backups/

# llama-ui 前端静态产物（9.3M 二进制，由 zip 解压生成，不入库）
web/llama-ui/

# 运行产物（2026-09-19 收敛）：这些目录由 Agent/评测在运行时写入，
# 跟踪它们会让每次运行都污染 git status，并重新堆积出本轮那 1555 个删除。
# 注意 materials/ 是用户输入资料，必须保持跟踪，不在此列。
# 历史评测产物统一归档（runs_*/reports/logs），不入库
archive/
!archive/
archive/*
!archive/README.md
runs_eval*/
runs_*/
code_sandbox/demo/
code_sandbox/f1_fixture/
# 沙箱 P0 验证产物（运行 churn，不入库；phase1_fixture 的夹具源码保持跟踪）
code_sandbox/auth_fix/
code_sandbox/fix_auth_calculate/
# Laya 源码本地 fork 副本（依赖副本，用于读其 API，非项目代码）
laya/_laya_inspect/
forge_data/
exports/
notes/
summaries/
report_*.json
runs_*.log
*.sqlite-shm
*.sqlite-wal
# benchmark 运行 churn：inline 工具产物，不入库
benchmark_fixture/_inline_*.py
benchmark_fixture/__pycache__/

# Laya checkpoint 副本（HF 缓存 2.3G，本地不入库）
data/laya_forge/

# CI 诊断产物：失败时由 workflow 推到 ci-diag 临时分支，
# 不应出现在 main（本地跑脚本时也会生成）
ci-diag/
